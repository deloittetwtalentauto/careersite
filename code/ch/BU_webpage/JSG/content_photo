  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const navButtons = Array.from(document.querySelectorAll(".nav-lang-btn"));
      const allLangElements = Array.from(document.querySelectorAll('[data-lang-target]'));
      let current = "";

      function updateButtonStyles(activeLang) {
        navButtons.forEach(btn => {
          if (btn.dataset.lang === activeLang) {
            btn.classList.add("text-white", "border-brand");
            btn.classList.remove("text-gray-500", "border-transparent", "hover:text-gray-300");
          } else {
            btn.classList.remove("text-white", "border-brand");
            btn.classList.add("text-gray-500", "border-transparent", "hover:text-gray-300");
          }
        });
      }

      function switchLang(lang) {
        if (lang === current) return;
        
        allLangElements.forEach(el => {
          if (el.dataset.langTarget === lang) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        updateButtonStyles(lang);
        current = lang;
      }

      navButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          switchLang(btn.dataset.lang);
        });
      });

      // Initialize with Chinese
      switchLang("zh");
    });
  </script>

