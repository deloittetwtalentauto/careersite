            <!-- Job Card 2: 數位專員 (使用輔助色 #0D8390) -->
            <div class="job-card card-digital">
                <div>
                    <span class="job-card-title">LDC 領組 (台中)</span>
                    <span class="job-card-loc">📍 台中</span>
                </div>
                <!-- 單一地點的職缺，直接放按鈕超連結，不需要下拉選單 -->
                <a href="https://careers.apac.deloitte.com/Taiwan/job/%E3%80%90%E5%AF%A9%E8%A8%88%E8%88%87%E7%A2%BA%E4%BF%A1%E8%AB%AE%E8%A9%A2%E6%9C%8D%E5%8B%99%E3%80%91LDC-%E5%B0%88%E6%A1%88%E6%9C%8D%E5%8B%99%E4%B8%AD%E5%BF%83-%E6%95%B8%E4%BD%8D%E5%B0%88%E5%93%A1%28%E5%8F%B0%E5%8C%97%29/1098-zh_TW" target="_blank" class="ldc-card-apply-btn">立即投遞</a>
            </div>

            <!-- Job Card 3: 長期實習生 (使用輔助色 #007CB0) -->
            <div class="job-card card-intern">
                <div>
                    <span class="job-card-title">LDC 領組 (高雄)</span>
                    <span class="job-card-loc">📍 高雄</span>
                </div>
                
                <a href="https://careers.apac.deloitte.com/Taiwan/job/FY27%E3%80%90%E5%AF%A9%E8%A8%88%E8%88%87%E7%A2%BA%E4%BF%A1%E8%AB%AE%E8%A9%A2%E6%9C%8D%E5%8B%99%E3%80%91LDC-%E5%B0%88%E6%A1%88%E6%9C%8D%E5%8B%99%E4%B8%AD%E5%BF%83-%E5%AF%A6%E7%BF%92%E7%94%9F-%28%E5%8F%B0%E5%8C%97%29/1094-zh_TW" target="_blank" class="ldc-card-apply-btn">立即投遞</a>
            </div>

        </div>

    </div>
</section>

</body>
</html>
