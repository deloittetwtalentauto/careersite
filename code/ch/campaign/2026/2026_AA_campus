<script>
  document.addEventListener("DOMContentLoaded", function () {
    // 取得今天的日期 (排除時分秒，只比較年月日)
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // 尋找所有設有截止日的按鈕
    const actionButtons = document.querySelectorAll("[data-end-date]");

    actionButtons.forEach(button => {
      const endDateStr = button.getAttribute("data-end-date"); // 格式: "YYYY-MM-DD"
      if (endDateStr) {
        const endDate = new Date(endDateStr);
        endDate.setHours(0, 0, 0, 0);

        // 如果今天大於或等於截止日期
        if (today >= endDate) {
          button.textContent = "已截止";
          button.href = "javascript:void(0);"; // 移除超連結點擊行為
          button.removeAttribute("target");    // 移除另開分頁
          button.classList.add("btn-disabled"); // 套用灰底禁用樣式
        }
      }
    });
  });
</script>

