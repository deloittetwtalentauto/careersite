    <script>
      document.addEventListener("DOMContentLoaded", function () {
        /* =========================================================
          1. 職缺區塊 (Apply Now) 截止日判斷
          ========================================================= */
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const actionButtons = document.querySelectorAll("[data-end-date]");
        actionButtons.forEach(button => {
          const endDateStr = button.getAttribute("data-end-date");
          if (endDateStr) {
            const endDate = new Date(endDateStr);
            endDate.setHours(0, 0, 0, 0);

            if (today >= endDate) {
              button.textContent = "已截止";
              button.href = "javascript:void(0);"; 
              button.removeAttribute("target");    
              button.classList.add("btn-disabled"); 
            }
          }
        });

        /* =========================================================
          2. 說明會 (Info Sessions) 動態資料渲染與切換邏輯
          ========================================================= */
        const sessionBtns = document.querySelectorAll(".info-bu-btn");
        const sessionGrid = document.getElementById("sessionGrid");
        const sessionCount = document.getElementById("sessionCount");
        const sessionPanelTitle = document.getElementById("sessionPanelTitle");

        const sessionTitleMap = {
          online: "💻 報名線上校園徵才說明會",
          physical: "🏫 報名實體校園徵才說明會"
        };

        // 說明會資料庫 (支援 endDate 設定)
        const sessionData = {
          online: [
            {
              title: "線上校園徵才說明會",
              pill: "Teams會議",
              desc: `歡迎以下同學報名參與:
    1. 各校會計科系、商管科系各年級同學、應屆畢業生
    2. 資管系所應屆畢業生 及 雙主修、輔系資管系所應屆畢業生
    3. 修習過中級會計學

    活動時間: 2026-09-XX(TBC)XX:00 - XX:30`,
              url: "#",
              endDate: "2026-09-30", // 注意：這裡必須填寫正確的日期格式 (如 2026-09-30)，自動反灰功能才會生效喔！
              fullWidth: true /* 新增：讓這張卡片佔滿兩格 */
            }
          ],
          physical: [
            // 注意：刻意中原設定為過期日期 (2026-07-15) 以展示自動反灰功能
            { title: "中原大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-07-15" },
            { title: "國立臺北大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-16" },
            { title: "國立成功大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-17" },
            { title: "元智大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-18" },
            { title: "輔仁大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-21" },
            { title: "逢甲大學(會計)", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-22" },
            { title: "淡江大學(資管)", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-23" },
            { title: "靜宜大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-24" },
            { title: "東吳大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-25" },
            { title: "東吳大學(資管)", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-28" },
            { title: "東海大學", pill: "TBC", desc: "活動時間: 2026-09-XX(TBC)XX:00 - XX:30", url: "#", endDate: "2026-09-28" }
          ]
        };

        // 防止 XSS 的跳脫字元處理
        function escapeHtml(str) {
          return String(str).replace(/[&<>"']/g, m => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
          })[m]);
        }

        // 渲染卡片/清單功能
        function renderSessions(typeKey) {
          const rawSessions = sessionData[typeKey] || [];
          
          // 【新增：自動排序功能】依據 endDate 進行時間先後排序 
          // 邏輯：日期越早的排越上面，如果沒有填寫 endDate (還在 TBC 的)，自動排在最後面
          const sessions = [...rawSessions].sort((a, b) => {
            const dateA = a.endDate ? new Date(a.endDate).getTime() : Infinity;
            const dateB = b.endDate ? new Date(b.endDate).getTime() : Infinity;
            return dateA - dateB; // 由小排到大 (由早排到晚)
          });
          
          sessionGrid.innerHTML = "";
          sessionPanelTitle.textContent = sessionTitleMap[typeKey];
          sessionCount.textContent = `${sessions.length} sessions`;
          
          // 如果是「實體說明會」，使用橫條清單排版
          if (typeKey === 'physical') {
            sessionGrid.className = "info-list-container";
            
            const listHtml = sessions.map(s => {
              let btnText = "報名參加";
              let btnClass = "info-card-link";
              let btnHref = escapeHtml(s.url);
              let targetAttr = 'target="_blank"';

              // 判斷是否已截止
              if (s.endDate) {
                const ed = new Date(s.endDate);
                ed.setHours(0, 0, 0, 0);
                if (today >= ed) {
                  btnText = "已截止";
                  btnClass += " btn-disabled";
                  btnHref = "javascript:void(0);";
                  targetAttr = "";
                }
              }

              return `
                <div class="info-list-item">
                  <div class="info-list-content">
                    <div class="info-list-header">
                      <h4 class="info-list-title">${escapeHtml(s.title)}</h4>
                      <span class="info-pill">📍 ${escapeHtml(s.pill)}</span>
                    </div>
                    <p class="info-list-desc">${escapeHtml(s.desc)}</p>
                  </div>
                  <div class="info-list-action">
                    <a class="${btnClass}" href="${btnHref}" ${targetAttr}>${btnText}</a>
                  </div>
                </div>
              `;
            }).join("");
            
            sessionGrid.innerHTML = listHtml;
          
          // 如果是「線上說明會」，維持原本的網格卡片排版
          } else {
            sessionGrid.className = "info-grid";
            
            const cardsHtml = sessions.map(s => {
              let btnText = "報名參加";
              let btnClass = "info-card-link";
              let btnHref = escapeHtml(s.url);
              let targetAttr = 'target="_blank"';
              let cardClass = "info-card";

              if (s.fullWidth) cardClass += " full-width";

              if (s.endDate) {
                const ed = new Date(s.endDate);
                ed.setHours(0, 0, 0, 0);
                if (today >= ed) {
                  btnText = "已截止";
                  btnClass += " btn-disabled";
                  btnHref = "javascript:void(0);";
                  targetAttr = "";
                }
              }

              return `
                <div class="${cardClass}">
                  <h4 class="info-card-title">${escapeHtml(s.title)}</h4>
                  <div><span class="info-pill">📍 ${escapeHtml(s.pill)}</span></div>
                  <p class="info-card-desc">${escapeHtml(s.desc)}</p>
                  <a class="${btnClass}" href="${btnHref}" ${targetAttr}>${btnText}</a>
                </div>
              `;
            }).join("");
            
            sessionGrid.innerHTML = cardsHtml;
          }
        }

        // 綁定左側導覽按鈕點擊事件
        sessionBtns.forEach(btn => {
          btn.addEventListener("click", function () {
            sessionBtns.forEach(b => b.classList.remove("is-active"));
            this.classList.add("is-active");
            renderSessions(this.getAttribute("data-type"));
          });
        });

        // 預設渲染線上場次
        renderSessions("online");

      });
    </script>

    </body>
    </html>
