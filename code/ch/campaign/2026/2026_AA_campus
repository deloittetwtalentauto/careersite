<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 A&A Campus</title>
<!-- 引入 Google Fonts: Open Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
/* =========================
   2026 A&A Campus – Sections CSS
   Brand: 黑 / 白 / #86BC25（輔色含於變數）
   ========================= */
:root{
  --brand:#86BC25;       /* 企業主色 */
  --black:#000;          /* 深色文字 */
  --white:#fff;          /* 反白背景 */
  --accent-1:#43B02A;    /* 輔色 1 */
  --accent-2:#26890D;    /* 輔色 2 */
  --accent-3:#046A38;    /* 輔色 3 */
  --accent-4:#0D8390;    /* 輔色 4 */
  --accent-5:#007CB0;    /* 輔色 5 */

  --text:#1a1a1a;
  --muted:#666;
  --border:#e6e6e6;
  --card:#ffffff;
  --surface:#f7f9f5;     /* Apply Now 區塊底色 */
  --radius:16px;
  --shadow:0 2px 10px rgba(0,0,0,.04);
}

/* 設定全局字體：英文優先使用 Aptos(Apotos)，遇到中文退回使用 Open Sans 及微軟正黑體 */
body {
  font-family: "Apotos", "Aptos", "Open Sans", "Microsoft JhengHei", "PingFang TC", sans-serif;
}

/* 通用區塊 */
.campus-section {padding:56px 20px;}
.container {max-width:1080px;margin:0 auto;}

/* 眉批 (Eyebrow) 標題設計 */
.eyebrow {
  display: block;
  font-size: 13px;
  font-weight: 800;
  color: #75787B; 
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 6px;
}

.section-title {
  font-size:clamp(24px,3vw,32px);
  font-weight:600;
  margin:0 0 16px;
  color:#86BC25 !important;
  letter-spacing:.5px;
}
.lead {
  font-size:clamp(16px,2.2vw,18px);
  line-height:1.8;
  color:var(--text);
  margin:0 0 16px;
}

/* 小重點條列 */
.highlights {margin:12px 0 20px;padding:0 0 0 20px;}
.highlights li {margin:8px 0;line-height:1.7;color:var(--text);}
.highlights li span {color:var(--brand);font-weight:700;}

/* 左右資訊條列（需求/條件） */
.meta {
  display:grid;
  gap:10px;
  margin-top:8px;
  font-size:15px;
  color:#333;
}

/* 關於區塊（白底改為精緻漸層與品牌雙色微光） */
.about {
  background: linear-gradient(135deg, var(--white) 0%, #f6faf2 100%);
  position: relative;
  overflow: hidden;
}
.about::before {
  content: "";
  position: absolute;
  top: -100px;
  right: -100px;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(134, 188, 37, 0.1) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.about::after {
  content: "";
  position: absolute;
  bottom: -150px;
  left: -150px;
  width: 450px;
  height: 450px;
  background: radial-gradient(circle, rgba(13, 131, 144, 0.05) 0%, rgba(255, 255, 255, 0) 70%); 
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.about .container {
  position: relative;
  z-index: 2;
}

/* 申請條件區 */
.requirements {
  background:#f5f5f5 !important;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}

/* Apply Now 區 */
.apply {background:var(--surface);}

/* 職缺清單：改用 CSS Grid 實現完美的響應式佈局 */
.job-list {
  display: grid;
  gap: 20px; 
  grid-template-columns: 1fr; 
}

@media (min-width: 768px) {
  .job-list { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 992px) {
  .job-list { grid-template-columns: repeat(4, 1fr); }
}

/* 卡片容器 */
.job-card {
  background: var(--card-bg, var(--card));
  border: 1px solid var(--card-accent, var(--border)); 
  border-radius: var(--radius);
  padding: 24px;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: transform .2s ease, box-shadow .2s ease;
}

/* 定義每張卡片的跳色變數 (結合 Deloitte 品牌輔色) */
.job-card:nth-child(1) { --card-accent: var(--brand); --card-bg: #f9fdf5; }     /* 經典綠 - 審計 */
.job-card:nth-child(2) { --card-accent: var(--accent-4); --card-bg: #f2fafa; }  /* 藍綠色 - 數位審計 */
.job-card:nth-child(3) { --card-accent: var(--accent-3); --card-bg: #f2f7f4; }  /* 深綠色 - 稅務 */
.job-card:nth-child(4) { --card-accent: var(--accent-5); --card-bg: #f0f8fb; }  /* 藍色 - 風險/財顧 */

.job-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 32px rgba(0,0,0,.08);
}
.job-header {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
}
.job-title {
  font-size:18px;
  margin:0;
  color: var(--card-accent, var(--accent-3)) !important; 
  font-weight:700;
  line-height: 1.4;
}

/* 新增：地點與職缺說明的樣式 */
.job-location {
  font-size: 14px;
  font-weight: 700;
  color: #333;
  margin: -4px 0 4px 0;
}

.job-desc {
  font-size: 14px;
  line-height: 1.6;
  color: #555;
  margin: 0;
  /* 讓描述區塊佔據剩餘空間，確保不管字數多少，底部的按鈕都能對齊 */
  flex-grow: 1; 
}

.job-actions {
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top: auto;      
  justify-content: center; 
}

@media (min-width: 768px) {
  .job-actions { justify-content: flex-start; }
}

/* 按鈕 */
.btn-primary, .btn-outline {
  display:inline-block;
  text-decoration:none;
  padding:10px 14px;
  border-radius:10px;
  font-weight:700;
  font-size:14px;
  line-height:1;
  transition:transform .06s ease, filter .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
}

/* 提升 CSS 權重，徹底壓制招募系統的預設超連結黑字 */
html body .campus-section .job-card a.btn-primary,
html body .campus-section .job-card a.btn-primary:link,
html body .campus-section .job-card a.btn-primary:visited {
  background: var(--card-accent, var(--brand)) !important;
  color: #ffffff !important;
  border: 2px solid var(--card-accent, var(--brand)) !important;
  -webkit-text-fill-color: #ffffff !important; 
}

/* 懸停(Hover)時變為精緻的黑底白字 */
html body .campus-section .job-card a.btn-primary:hover,
html body .campus-section .job-card a.btn-primary:focus {
  background: #1a1a1a !important; 
  color: #ffffff !important; 
  border-color: #1a1a1a !important;
  -webkit-text-fill-color: #ffffff !important;
}

/* 已截止/已結束按鈕樣式 (加強防護 CSB 覆蓋) */
html body .campus-section .btn-disabled,
html body .campus-section a.btn-disabled {
  background-color: #d1d5db !important; 
  border-color: #d1d5db !important;
  color: #9ca3af !important; 
  -webkit-text-fill-color: #9ca3af !important;
  cursor: not-allowed !important; 
  pointer-events: none; 
  transform: none !important;
  box-shadow: none !important;
}

/* 小備註區塊 */
.note-box {
  margin-top: 24px;
  padding: 18px 20px;
  background-color: #fbfdf9; 
  border: 1px solid #e2ebd5;
  border-left: 4px solid var(--brand); 
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,.02);
}
.note-box-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 10px 0;
}
.note-list {
  margin: 0;
  padding-left: 20px;
  font-size: 14px;
  color: #444;
  line-height: 1.7;
}

/* ===== Circles Timeline ===== */
.timeline-circles {
  margin-top:28px;
  padding:10px 0;
  text-align:center;
}
.timeline-circles .steps {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:32px;
}
.timeline-circles .step {
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
  text-align:center;
}
.timeline-circles .circle {
  width:120px; height:120px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  color:var(--brand); font-weight:800; line-height:1.15; text-align:center;
  background:var(--white);
  border: 4px solid var(--brand);
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}
.timeline-circles .circle span {
  display:inline-block;
  font-size:18px;
}
.timeline-circles .label {
  font-size:15px; font-weight:600; color:#53565A;
  margin:0;
}

@media (min-width:769px){
  .timeline-circles .steps::before {
    content:"";
    position:absolute; left:0; right:0; top:70px;
    height:4px; background:var(--brand);
    z-index:-1; border-radius:2px;
  }
  .timeline-circles .steps { position:relative; }
}

@media (max-width:768px){
  .timeline-circles .steps {
    flex-direction:column;      
    align-items:center;         
    justify-content:flex-start; 
    gap:20px;
  }
  .timeline-circles .step {
    flex:none;                 
    width:100%;
    text-align:center;
  }
  .timeline-circles .circle {
    width:96px; height:96px;
    margin:0 auto;              
  }
}

/* ===== Info Sessions (新增說明會樣式) ===== */
.info-session {
  background: var(--white);
}

/* 線上說明會主打卡片 */
.online-session-card {
  background: linear-gradient(135deg, var(--accent-3) 0%, var(--brand) 100%);
  color: var(--white);
  padding: 28px 32px;
  border-radius: var(--radius);
  margin-bottom: 40px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 10px 30px rgba(134, 188, 37, 0.25);
  position: relative;
  overflow: hidden;
}
.online-session-card::after {
  content: "💻";
  font-size: 100px;
  position: absolute;
  right: 20px;
  bottom: -20px;
  opacity: 0.15;
  pointer-events: none;
}
@media(min-width: 768px){
  .online-session-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}
.online-session-info h3 {
  margin: 0 0 8px 0;
  font-size: 24px;
  color: var(--white) !important;
  font-weight: 700;
}
.online-session-info p {
  margin: 0;
  font-size: 16px;
  line-height: 1.6;
  opacity: 0.95;
}
.btn-white {
  background: var(--white);
  color: var(--accent-3);
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 15px;
  text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
  white-space: nowrap;
  text-align: center;
  z-index: 2; /* 確保按鈕在裝飾 icon 之上 */
}
.btn-white:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 16px rgba(0,0,0,0.15);
}

/* 實體說明會小標題 */
.subsection-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 20px 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.subsection-title::before {
  content: "";
  display: inline-block;
  width: 5px;
  height: 22px;
  background: var(--brand);
  border-radius: 3px;
}

/* 實體說明會網格 */
.physical-sessions-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: 1fr;
}
@media (min-width: 600px) {
  .physical-sessions-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 992px) {
  .physical-sessions-grid { grid-template-columns: repeat(3, 1fr); }
}

/* 實體說明會卡片 */
.session-card {
  background: #fdfdfd;
  border: 1px solid var(--border);
  border-left: 4px solid var(--brand);
  padding: 18px 20px;
  border-radius: 10px;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-left-color 0.2s ease;
  display: flex;
  flex-direction: column;
}
.session-card:hover {
  transform: translateX(4px);
  box-shadow: 0 6px 16px rgba(0,0,0,0.06);
  border-left-color: var(--accent-3); /* Hover 時左側線條變深綠色 */
}
.session-school {
  font-size: 18px;
  font-weight: 700;
  color: var(--accent-3);
  margin: 0 0 10px 0;
}
.session-details {
  font-size: 14px;
  color: #555;
  margin: 0 0 16px 0;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
  flex-grow: 1; /* 讓按鈕自動對齊底部 */
}
.session-details span {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* 說明會專屬報名按鈕 (輕量線條感) */
html body .campus-section .session-card a.btn-session,
html body .campus-section .session-card a.btn-session:link,
html body .campus-section .session-card a.btn-session:visited {
  display: inline-block;
  text-align: center;
  background: var(--white) !important;
  color: var(--accent-3) !important;
  border: 1px solid var(--accent-3) !important;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  -webkit-text-fill-color: var(--accent-3) !important;
  transition: all 0.2s ease;
}
html body .campus-section .session-card a.btn-session:hover,
html body .campus-section .session-card a.btn-session:focus {
  background: var(--accent-3) !important;
  color: var(--white) !important;
  -webkit-text-fill-color: var(--white) !important;
}
</style>
</head>
