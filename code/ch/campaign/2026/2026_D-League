<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 D-League Internship Program</title>
<!-- 引入 Google Fonts: Open Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
/* =========================
   2026 D-League Internship Program – Sections CSS
   Brand: 黑 / 白 / #86BC25（輔色含於變數）
   ========================= */
:root{
  --brand:#86BC25;       /* 主色 */
  --black:#000;          /* 深色文字 */
  --white:#fff;          /* 反白背景 */
  --accent-1:#43B02A;    /* 輔色 */
  --accent-2:#26890D;
  --accent-3:#046A38;
  --accent-4:#0D8390;
  --accent-5:#007CB0;

  --text:#1a1a1a;
  --muted:#666;
  --border:#e6e6e6;
  --card:#ffffff;
  --surface:#f7f9f5;     /* Apply Now 區塊底色 */
  --radius:16px;
  --shadow:0 2px 10px rgba(0,0,0,.04);
}

/* 設定全局字體：英文優先使用 Aptos(Apotos)，遇到中文退回使用 Open Sans 及微軟正黑體 */
body {
  font-family: "Apotos", "Aptos", "Open Sans", "Microsoft JhengHei", "PingFang TC", sans-serif;
}

/* 通用區塊 */
.dleague {padding:56px 20px;}
.container {max-width:1080px;margin:0 auto;}

/* 眉批 (Eyebrow) 標題設計 */
.eyebrow {
  display: block;
  font-size: 13px;
  font-weight: 800;
  color: #75787B; /* 使用深綠色增加層次感 */
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 6px;
}

.section-title {
  font-size:clamp(24px,3vw,32px);
  font-weight:600;
  margin:0 0 16px;
  color:#86BC25 !important;
  letter-spacing:.5px;
}
.lead {
  font-size:clamp(16px,2.2vw,18px);
  line-height:1.8;
  color:var(--text);
  margin:0 0 16px;
}

/* 小重點條列 */
.highlights {margin:12px 0 20px;padding:0 0 0 20px;}
.highlights li {margin:8px 0;line-height:1.7;color:var(--text);}
.highlights li span {color:var(--brand);font-weight:700;}

/* 左右資訊條列（需求/條件） */
.meta {
  display:grid;
  gap:10px;
  margin-top:8px;
  font-size:15px;
  color:#333;
}

/* 關於區塊（白底改為精緻漸層與品牌雙色微光） */
.about {
  background: linear-gradient(135deg, var(--white) 0%, #f6faf2 100%);
  position: relative;
  overflow: hidden;
}
.about::before {
  content: "";
  position: absolute;
  top: -100px;
  right: -100px;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(134, 188, 37, 0.1) 0%, rgba(255, 255, 255, 0) 70%); /* 品牌綠微光 */
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.about::after {
  content: "";
  position: absolute;
  bottom: -150px;
  left: -150px;
  width: 450px;
  height: 450px;
  background: radial-gradient(circle, rgba(13, 131, 144, 0.05) 0%, rgba(255, 255, 255, 0) 70%); /* 輔色藍綠色微光 */
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.about .container {
  position: relative;
  z-index: 2; /* 確保文字在光暈上方，不影響選取 */
}

/* 申請條件區（可與 about 同色，或改為非常淡的灰） */
.requirements {
  background:#f5f5f5 !important;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}

/* Apply Now 區（淡綠底） */
.apply {background:var(--surface);}

/* 職缺清單 */
.job-list {display:grid;grid-template-columns:1fr;gap:16px;}
@media (min-width:720px){
  .job-list {grid-template-columns:1fr 1fr;}
}

/* 卡片容器：設為 flex 佈局使內容可以垂直伸展 */
.job-card {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:18px;
  box-shadow:var(--shadow);
  display: flex;
  flex-direction: column;
}
.job-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}
.job-title {
  font-size:18px;
  margin:0;
  color:#111;
  font-weight:700;
}
.job-badge {
  display:inline-block;
  padding:6px 10px;
  background:var(--brand);
  color:var(--white);
  border-radius:999px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.3px;
  white-space:nowrap;
}
.job-info {
  list-style:none;
  margin:12px 0 16px;
  padding:0;
  color:#333;
  font-size:14px;
}
.job-info li {margin:6px 0;}

.job-desc {
  margin: 12px 0 16px;
  color: #444;
  font-size: 14px;
  line-height: 1.75;
  text-align: justify;
}

/* 按鈕容器：設為 flex 佈局使內容可以垂直伸展 */
.job-actions {
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top: auto;      /* 置底關鍵 */
  justify-content: center; /* 手機板預設置中 */
}

@media (min-width: 768px) {
  .job-actions {
    justify-content: flex-start; /* 電腦版改為靠左對齊 */
  }
}

/* 按鈕 */
.btn-primary,
.btn-outline {
  display:inline-block;
  text-decoration:none;
  padding:10px 14px;
  border-radius:10px;
  font-weight:700;
  font-size:14px;
  line-height:1;
  transition:transform .06s ease, filter .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
}
.btn-primary {
  background:var(--brand);
  color:var(--white)!important;
  border:2px solid var(--brand);
}

/* 懸停(Hover)時變為精緻的黑底白字 */
.btn-primary:hover {
  background:var(--black);
  color:var(--white);
  border-color:var(--black);
}
.btn-primary:active {transform:translateY(1px);}

/* 已截止/已結束按鈕樣式 */
.btn-disabled {
  background-color: #d1d5db !important; /* 灰色背景 */
  border-color: #d1d5db !important;
  color: #9ca3af !important; /* 灰字 */
  cursor: not-allowed !important; /* 禁用游標 */
  pointer-events: none; /* 禁用所有點擊與滑鼠事件 */
  transform: none !important;
  box-shadow: none !important;
}

.btn-outline {
  border:2px solid var(--black);
  color:var(--black);
  background:transparent;
}
.btn-outline:hover {background:var(--black)!important;color:var(--white)!important;}
.btn-outline:active {transform:translateY(1px);}

/* 小備註區塊（圓角外框與左側品牌條） */
.note-box {
  margin-top: 24px;
  padding: 18px 20px;
  background-color: #fbfdf9; /* 極淡綠色底，舒適溫和 */
  border: 1px solid #e2ebd5;
  border-left: 4px solid var(--brand); /* 左側高質感品牌綠色標籤 */
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,.02);
}
.note-box-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 10px 0;
}
.note-list {
  margin: 0;
  padding-left: 20px;
  font-size: 14px;
  color: #444;
  line-height: 1.7;
}
.note-list li {
  margin-bottom: 6px;
}
.note-list li:last-child {
  margin-bottom: 0;
}
.note-list li strong {
  color: var(--accent-3); /* 使用深綠色強調 */
}

/* 鍵盤可及性：聚焦樣式 */
a:focus-visible,
button:focus-visible,
.btn-primary:focus-visible,
.btn-outline:focus-visible {
  outline:3px solid color-mix(in oklab, var(--brand) 60%, white);
  outline-offset:2px;
  border-radius:12px;
}

/* 使用者偏好：減少動態 */
@media (prefers-reduced-motion:reduce){
  .btn-primary,.btn-outline{transition:none;}
}

/* 可選：內文中強調色（若需要） */
.emphasis-brand {color:var(--brand);font-weight:700;}
.emphasis-accent {color:var(--accent-3);font-weight:700;}

/* 可選：錨點平滑滾動（若頁面上有導覽錨點） */
html:has(#about-dleague, #application-requirements, #apply-now) {
  scroll-behavior:smooth;
}

/* ===== Circles Timeline（命名空間避免衝突） ===== */
.timeline-circles {
  margin-top:28px;
  padding:10px 0;
  text-align:center;
}
.timeline-circles .timeline-title {
  font-size:20px;
  font-weight:800;
  color:var(--brand);
  margin-bottom:16px;
}
.timeline-circles .steps {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:32px;
}
.timeline-circles .step {
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
  text-align:center;
}
.timeline-circles .circle {
  width:120px; height:120px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  color:var(--brand); font-weight:800; line-height:1.15; text-align:center;
  background:var(--white);
  border: 4px solid var(--brand); /* 綠色外框 */
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}
.timeline-circles .circle span {
  display:inline-block;
  font-size:18px;
}
.timeline-circles .label {
  font-size:15px; font-weight:600; color:#53565A;
  margin:0;
}

/* 桌面水平導線（可選） */
@media (min-width:769px){
  .timeline-circles .steps::before {
    content:"";
    position:absolute; left:0; right:0; top:70px;
    height:4px; background:var(--brand);
    z-index:-1; border-radius:2px;
  }
  .timeline-circles .steps {
    position:relative;
  }
}

/* RWD：手機改直式堆疊 + 置中修正 */
@media (max-width:768px){
  .timeline-circles .steps {
    flex-direction:column;      /* 直向堆疊 */
    align-items:center;         /* 水平置中每個 .step（含圈圈）*/
    justify-content:flex-start; /* 取消 space-between 造成的上下撐開 */
    gap:20px;
  }
  .timeline-circles .step {
    flex:none;                  /* 避免 flex:1 撐滿寬度造成視覺偏左 */
    width:100%;
    text-align:center;
  }
  .timeline-circles .circle {
    width:96px; height:96px;
    margin:0 auto;              /* 再保險，圈圈本身也置中 */
  }
  .timeline-circles .circle span {
    font-size:16px;
  }
}
</style>
</head>
