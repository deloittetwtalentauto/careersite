<!--
  Deloitte Taiwan Careers 首頁 — Slogan Section
  說明：
  1. 白底、極簡風格，靠三個細節堆疊層次：
     - 上方小標籤（.slogan-eyebrow）當視覺前導，主色 #86BC25、字距加寬、全大寫
     - 主標語分兩行呈現，"impact" 用螢光筆式底色（.slogan-highlight，
       淡綠色 #cfe8a6）局部強調，其餘文字維持黑色
     - 下方一條短分隔線（.slogan-divider）收尾，同樣使用主色
  2. 若不想強調 "impact"，可直接移除該字外層的 .slogan-highlight span，
     文字會恢復純黑無底色。
  3. 建議放置位置：可放在校園招募／社會招募 section 之後、
     About Deloitte 之前，作為過場轉折的呼吸空間。
  4. 字級、標籤與分隔線間距已包含手機版 RWD 調整。
-->

<section class="slogan-section">
  <style>
    .slogan-section {
      width: 100%;
      background-color: #ffffff;
      padding: 100px 24px;
      box-sizing: border-box;
      text-align: center;
    }

    .slogan-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .slogan-eyebrow {
      display: inline-block;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #86BC25;
      margin-bottom: 20px;
    }

    .slogan-text {
      font-size: 48px;
      font-weight: 700;
      color: #111111;
      line-height: 1.35;
      margin: 0;
      letter-spacing: -0.01em;
    }

    /* 局部強調用的螢光筆效果，套用在指定文字外層 span */
    .slogan-highlight {
      position: relative;
      display: inline-block;
    }

    .slogan-highlight::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 2px;
      height: 10px;
      background-color: #cfe8a6;
      z-index: -1;
    }

    .slogan-divider {
      width: 48px;
      height: 3px;
      background-color: #86BC25;
      margin: 28px auto 0;
    }

    @media (max-width: 768px) {
      .slogan-section {
        padding: 64px 20px;
      }

      .slogan-text {
        font-size: 30px;
      }

      .slogan-divider {
        margin-top: 20px;
      }
    }
  </style>

  <div class="slogan-inner">
    <span class="slogan-eyebrow">Careers at Deloitte</span>
    <p class="slogan-text">
      Begin your journey,<br>
      create <span class="slogan-highlight">impact</span>.
    </p>
    <div class="slogan-divider"></div>
  </div>
</section>
