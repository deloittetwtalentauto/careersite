<section style="position: relative !important; background-color: #f4f4f4 !important;">
  
  <div style="text-align: center !important; background-color: #000 !important;">
    <img src="https://raw.githubusercontent.com/joycehsudeloitte/careersite/main/images/banner/desktop/career_site_banner_desktop.jpg" 
         alt="Job at Deloitte Desktop" 
         class="banner-desktop-img"
         style="max-width: 100% !important; height: auto !important; margin: 0 auto !important;">
    
    <img src="https://raw.githubusercontent.com/joycehsudeloitte/careersite/main/images/banner/mobile/hompage_banner_mobile.jpg" 
         alt="Job at Deloitte Mobile" 
         class="banner-mobile-img"
         style="max-width: 100% !important; height: auto !important; margin: 0 auto !important;">
  </div>

  <style>
    /* --- Banner 顯示控制 --- */
    .banner-desktop-img { display: block !important; }
    .banner-mobile-img { display: none !important; }

    /* --- 手機版響應式設定 --- */
    @media (max-width: 768px) {
      .banner-desktop-img { display: none !important; }
      .banner-mobile-img { display: block !important; }
    }
  </style>

</section>
