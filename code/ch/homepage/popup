<div id="autoPromoModal" class="modal-overlay">
  <div class="modal-content" style="max-width: 600px !important; padding: 40px !important;">
    <span onclick="closeModal('autoPromoModal')" style="position:absolute !important; right:20px !important; top:15px !important; font-size:35px !important; cursor:pointer !important; color:#ccc !important;">&times;</span>
    
    <div class="promo-content">
      <!-- HR 可以把 src 換成當期招募海報的網址，若無海報也可把 img 整行刪除 -->
      <!-- <img src="你的宣傳海報網址.jpg" alt="2026 D-League Internship"> -->
      
