  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const navButtons = Array.from(document.querySelectorAll(".nav-lang-btn"));
      const quotes = Array.from(document.querySelectorAll(".mentor-quote-text"));
      const zhElements = Array.from(document.querySelectorAll('[data-lang-target="zh"]'));
      const jaElements = Array.from(document.querySelectorAll('[data-lang-target="ja"]'));
      let current = ""; // 初始化為空

      // 設定導覽列按鈕的外觀 (文字顏色 + 企業色底線)
      function updateButtonStyles(activeLang) {
        navButtons.forEach(btn => {
          const isMatch = btn.dataset.lang === activeLang;
          if (isMatch) {
            // 啟用狀態：白色字體 + 企業綠底線
            btn.classList.add("text-white", "border-brand");
            btn.classList.remove("text-gray-500", "border-transparent", "hover:text-gray-300");
          } else {
            // 未啟用狀態：灰色字體 + 透明底線
            btn.classList.remove("text-white", "border-brand");
            btn.classList.add("text-gray-500", "border-transparent", "hover:text-gray-300");
          }
        });
      }

      // 切換語言功能
      function switchLang(lang) {
        if (lang === current) return;
        
        // 1. 卡片引言文字先加入淡出與位移的 CSS class
        quotes.forEach(q => {
          q.classList.add("opacity-0", "-translate-y-2");
        });

        // 2. 標題與簡介文字瞬間切換 (透過 Tailwind 的 hidden)
        if (lang === 'zh') {
          zhElements.forEach(el => el.classList.remove('hidden'));
          jaElements.forEach(el => el.classList.add('hidden'));
        } else {
          zhElements.forEach(el => el.classList.add('hidden'));
          jaElements.forEach(el => el.classList.remove('hidden'));
        }

        // 3. 等待 200 毫秒後，替換人物卡片引言內容並淡入
        setTimeout(() => {
          quotes.forEach(q => {
            q.textContent = q.dataset[lang] || q.textContent;
            q.classList.remove("opacity-0", "-translate-y-2");
          });
        }, 200);

        updateButtonStyles(lang);
        current = lang;
      }

      // 監聽導覽列的點擊事件
      navButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          switchLang(btn.dataset.lang);
        });
      });

      // 畫面初始載入時，預設顯示「中文」
      switchLang("zh");
    });
  </script>

